{
  "datasets": [
    {
      "name": "sinistres_rbac",
      "displayName": "Sinistres RBAC",
      "queryLines": [
        "SELECT \n",
        "  CASE\n",
        "    WHEN\n",
        "      is_account_group_member('Data Engineer')\n",
        "      OR is_account_group_member('Directeur général')\n",
        "      OR session_user() IN ('Data Engineer', 'Directeur général')\n",
        "    THEN\n",
        "         CAST(s.MASTER_CLIENT_ID AS STRING)\n",
        "    ELSE '****'\n",
        "  END AS SINISTRE_ID,\n",
        "  CASE\n",
        "    WHEN\n",
        "      is_account_group_member('Data Engineer')\n",
        "      OR is_account_group_member('Directeur général')\n",
        "      OR session_user() IN ('Data Engineer', 'Directeur général')\n",
        "    THEN\n",
        "      s.CONTRAT_ID\n",
        "    ELSE '****'\n",
        "  END AS CONTRAT_ID,\n",
        "  c.TYPE_CONTRAT,\n",
        "  CASE\n",
        "    WHEN\n",
        "      is_account_group_member('Data Engineer')\n",
        "      OR is_account_group_member('Directeur général')\n",
        "      OR session_user() IN ('Data Engineer', 'Directeur général')\n",
        "    THEN\n",
        "      CAST(s.MASTER_CLIENT_ID AS STRING)\n",
        "    ELSE '****'\n",
        "  END AS MASTER_CLIENT_ID,\n",
        "  cl.Nom_Hached AS Nom,\n",
        "  cl.Prenom_Hached AS Prenom,\n",
        "  s.MONTANT_INDEMNISE,\n",
        "  s.STATUT_SINISTRE\n",
        "FROM\n",
        "  workspace.gold.fact_sinistres s\n",
        "    LEFT JOIN workspace.gold.fact_contrats c\n",
        "      ON s.CONTRAT_ID = c.CONTRAT_ID\n",
        "    LEFT JOIN workspace.gold.dim_clients_gold cl\n",
        "      ON c.MASTER_CLIENT_ID = cl.MASTER_CLIENT_ID\n",
        "WHERE\n",
        "  c.CONTRAT_ID IS NOT NULL"
      ]
    }
  ],
