          "name": "client_distribution_and_contract_insight_summary_dataset",
          "datasetName": "c026a737"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "gold_fact_contrat",
          "to": "gold_dim_client",
          "on": "`gold_fact_contrat`.`MASTER_CLIENT_ID` = `gold_dim_client`.`MASTER_CLIENT_ID`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "gold_fact_sinistre",
          "to": "gold_fact_contrat",
          "on": "`gold_fact_sinistre`.`CONTRAT_ID` = `gold_fact_contrat`.`CONTRAT_ID`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ],
      "measureExpressions": [
        {
          "name": "chiffre_affaires",
          "expression": "MEASURE(`gold_fact_contrat`.`prime_total`)"
        },
        {
          "name": "indemnites_versees",
          "expression": "SUM(`gold_fact_sinistre`.`MONTANT_INDEMNISE`)"
        },
        {
          "name": "ratio_sinistralite",
          "expression": "SUM(`gold_fact_sinistre`.`MONTANT_INDEMNISE`) / MEASURE(`gold_fact_contrat`.`prime_total`) * 100"
        }
      ]
    }
