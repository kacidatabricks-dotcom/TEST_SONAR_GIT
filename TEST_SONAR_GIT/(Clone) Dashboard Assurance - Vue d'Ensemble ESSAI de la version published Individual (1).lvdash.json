    {
      "name": "c026a737",
      "displayName": "client distribution and contract insight summary dataset",
      "queryLines": [
        "\r\n",
        "\r\n",
        "\r\n",
        "--sql\r\n",
        "\r\n",
        "/*\r\n",
        "# Création du Dashboard directement sous Databricks\r\n",
        "# Pour réaliser les visualisations demandées : \r\n",
        "\r\n",
        "\r\n",
        "#1.\tCréez une nouvelle cellule SQL dans votre notebook.\r\n",
        "\r\n",
        "#2.\tExécutez les 4 requêtes ci-dessous.\r\n",
        "\r\n",
        "#3.\tCliquez sur l'icône \"+\" à côté des résultats de la cellule -> Visualization, sélectionnez le type de graphique, puis cliquez sur Add to Dashboard. \r\n",
        "\r\n",
        "*/\r\n",
        "\r\n",
        "\r\n",
        "-- 0. Nombre total de clients dans la base\r\n",
        "SELECT COUNT(DISTINCT MASTER_CLIENT_ID) AS total_clients\r\n",
        "FROM workspace.default.gold_dim_client;\r\n",
        "\r\n",
        "-- 1. Répartition des clients par code postal (Pie Chart)\r\n",
        "SELECT CODE_POSTAL, COUNT(DISTINCT MASTER_CLIENT_ID) AS nb_clients\r\n",
        "FROM workspace.default.gold_dim_client\r\n",
        "GROUP BY CODE_POSTAL;\r\n",
        "\r\n",
        "-- 2. Statistiques des contrats par type (Bar Chart)\r\n",
        "SELECT TYPE_CONTRAT, COUNT(CONTRAT_ID) AS nb_contrats, SUM(MONTANT_PRIME) AS montant_total\r\n",
        "FROM workspace.default.gold_fact_contrat\r\n",
        "GROUP BY TYPE_CONTRAT;\r\n",
        "\r\n",
        "-- 3. Statistiques sinistres et financières (KPIs)\r\n",
        "SELECT \r\n",
        "    SUM(c.MONTANT_PRIME) AS chiffre_affaires,\r\n",
        "    SUM(s.MONTANT_INDEMNISE) AS indemnites_versees,\r\n",
        "    ROUND((SUM(s.MONTANT_INDEMNISE) / SUM(c.MONTANT_PRIME)) * 100, 2) AS ratio_sinistralite_pct\r\n",
        "FROM workspace.default.gold_fact_contrat c\r\n",
        "LEFT JOIN workspace.default.gold_fact_sinistre s \r\n",
        "    ON c.CONTRAT_ID = s.CONTRAT_ID;\r\n",
        "\r\n",
        "-- 4. Matrice des doublons (Table Filter)\r\n",
        "SELECT MASTER_CLIENT_ID, NOM, PRENOM, COUNT(*) AS nb_comptes\r\n",
        "FROM workspace.default.gold_dim_client\r\n",
        "GROUP BY MASTER_CLIENT_ID, NOM, PRENOM\r\n",
        "HAVING COUNT(*) > 1;\r\n",
        "\r\n",
        "--SQL\r\n",
        "--0. Création de l'information total_clients\r\n",
        "SELECT COUNT(DISTINCT MASTER_CLIENT_ID) as total_clients\r\n",
        "FROM gold_dim_client;\r\n",
        "\r\n",
        "-- 1. Répartition des clients par Ville (Graphique Camembert / Pie Chart)\r\n",
        "SELECT CODE_POSTAL, COUNT(DISTINCT MASTER_CLIENT_ID) as total_clients\r\n",
        "FROM gold_dim_client\r\n",
        "GROUP BY CODE_POSTAL;"
      ],
      "catalog": "workspace",
      "schema": "default"
    }
  ],
